  "narrative": {
    "overview": "The cashier interface follows the original minimal, professional brief: light, low-glare surfaces, dark ink and a restrained deep teal for primary actions and selected controls. It is an operational surface layered on the existing WooCommerce POS backend. Its density supports repeated product selection and verification of funds actually received.\n\nPersian RTL and English LTR share the same visual system. Store identity, catalog photographs, names, stock and money come from the actual store. The current scope is the cashier and thermal receipt; dashboards and later management modules have no implemented design system here. No user-approved creative metaphor or store-specific identity has been established.",
    "keyCharacteristics": [
      "Light surfaces, quiet borders and a single primary action color.",
      "Compact, readable typography with tabular financial figures.",
      "A catalog beside an order workspace on desktop, with two workspace tabs on mobile.",
      "Visible preparation, payment, recovery and completion states."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Use the primary accent to identify actionable and selected states; communicate financial state in text as well as color.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Preserve tonal separation and borders as the depth vocabulary of the current cashier surface.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the minimal professional character, logical alignment and shared RTL/LTR system.",
      "**Do** use real store/catalog information and let names, notices and references wrap.",
      "**Do** keep stock, estimates, final totals and received-funds status explicit in text.",
      "**Do** retain visible keyboard focus, mobile-visible feedback and reduced-motion behavior.",
      "**Do** use separators and tonal fills to organize the cashier workspace."
    ],
    "donts": [
      "**Don't** introduce decorative metrics, charts or dashboard framing into this operational surface.",
      "**Don't** hide uncertain payment outcomes or imply that recording funds charges a card.",
      "**Don't** hardcode a store brand, currency or sample catalog into the application.",
      "**Don't** turn this cashier implementation into an invented design specification for later modules."
    ]
  }
}
